{
  "info": {
    "name": "Compass API - Postman Collection",
    "_postman_id": "compass-api-collection",
    "description": "Collection for Compass Django API (auth, users, articles, categories). Includes auth token extraction tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"password\": \"strongpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/accounts/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api", "v1", "accounts", "auth", "register", ""
              ]
            }
          }
        },
        {
          "name": "Login (public) - extract tokens",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"strongpassword\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/accounts/auth/login/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","auth","login",""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) { pm.environment.set('access_token', json.access); }",
                  "if (json.refresh) { pm.environment.set('refresh_token', json.refresh); }",
                  "pm.test('Response has access token', () => { pm.expect(json).to.have.property('access'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/accounts/auth/refresh/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","auth","refresh",""] }
          }
        },
        {
          "name": "Verify token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{access_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/accounts/auth/verify/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","auth","verify",""] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
            "url": { "raw": "{{base_url}}/api/v1/accounts/users/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","users",""] }
          }
        },
        {
          "name": "Create (register via users router)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new@example.com\",\n  \"first_name\": \"New\",\n  \"last_name\": \"User\",\n  \"password\": \"strongpassword\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/accounts/users/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","users",""] }
          }
        },
        {
          "name": "Get user by id",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/accounts/users/:id/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","users",":id",""] } }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/accounts/users/me/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","users","me",""] } }
        },
        {
          "name": "Change password (authenticated)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key":"Authorization","value":"Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"old_password\": \"oldpass\",\n  \"new_password\": \"newstrongpass\"\n}" }, "url": { "raw": "{{base_url}}/api/v1/accounts/users/change-password/", "host": ["{{base_url}}"], "path": ["api","v1","accounts","users","change-password",""] } }
        },
        {
          "name": "Search users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/accounts/users/search/?q=example", "host": ["{{base_url}}"], "path": ["api","v1","accounts","users","search",""], "query": [{"key":"q","value":"example"}] } }
        }
      ]
    },
    {
      "name": "Articles",
      "item": [
        {
          "name": "List Articles",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/articles/", "host": ["{{base_url}}"], "path": ["api","v1","articles",""] } }
        },
        {
          "name": "Create Article",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key":"Authorization","value":"Bearer {{access_token}}" }], "body": { "mode":"raw","raw":"{\n  \"title\": \"My Article\",\n  \"category\": 1,\n  \"excerpt\": \"Short excerpt\",\n  \"content\": \"Full content here\"\n}" }, "url": { "raw": "{{base_url}}/api/v1/articles/", "host": ["{{base_url}}"], "path": ["api","v1","articles",""] } }
        },
        {
          "name": "Get Article by slug",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/articles/:slug/", "host": ["{{base_url}}"], "path": ["api","v1","articles",":slug",""] } }
        },
        {
          "name": "Publish Article",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/articles/:slug/publish/", "host": ["{{base_url}}"], "path": ["api","v1","articles",":slug","publish",""] } }
        },
        {
          "name": "Unpublish Article",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/articles/:slug/unpublish/", "host": ["{{base_url}}"], "path": ["api","v1","articles",":slug","unpublish",""] } }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/api/v1/categories/", "host": ["{{base_url}}"], "path": ["api","v1","categories",""] } }
        },
        {
          "name": "Create Category",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" },{ "key":"Authorization","value":"Bearer {{access_token}}" }], "body": { "mode":"raw","raw":"{\n  \"name\": \"Technology\",\n  \"slug\": \"technology\"\n}" }, "url": { "raw": "{{base_url}}/api/v1/categories/", "host": ["{{base_url}}"], "path": ["api","v1","categories",""] } }
        }
      ]
    }
  ]
}
